# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/*.db

# Artwork images ARE committed (needed for the exhibition to work on deploy).

# Local source folders (originals) — redundant with public/, kept out of the repo.
/artworks-source/
/Music/

# Soundtrack: none ships with this repo. If you add one to public/audio/, commit
# it directly (not Git LFS — Vercel does not pull LFS) and make sure you have
# the right to distribute it.

# visitor-submitted messages (private; regenerated at runtime)
/data/messages.json

# 수상작 전시: 빌드 때 수상작/ 폴더에서 자동 생성되는 파일
/public/artworks/award-*
/public/exhibition.json
/public/artworks/background.*

# 배경 모델 작업 폴더 (scripts/scenery)
/scenery-src

# 수상작 원본 사진 (HEIC, 장당 1~2MB) — 전시에는 잘라 펴 낸 IMG_*.jpg 를 쓴다
수상작/*.HEIC
수상작/*.heic
