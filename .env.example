# ─────────────────────────────────────────────────────────────
# Museum Engine — Environment configuration
# Copy this file to `.env` and fill in the values you need.
# The museum runs fully WITHOUT any of these (layout persists to
# a local JSON file). These are only required for the optional
# Supabase / Postgres backend and admin authentication.
# ─────────────────────────────────────────────────────────────

# Source folder scanned by scripts/import-artworks.mjs.
# Defaults to an empty folder so nothing is auto-imported until you add photos.
ARTWORK_SOURCE_DIR="./public/artworks-empty"

# ── Supabase Auth (recommended for /admin) ───────────────────
# When both are set, /admin uses Supabase email/password instead of ADMIN_PASSWORD.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional: comma-separated emails allowed to use /admin (empty = any signed-in user).
# ADMIN_EMAILS="you@example.com"

# ── Postgres via Prisma (optional) ───────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/museum?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/museum?schema=public"

# ── Admin panel fallback (local dev when Supabase is not configured) ──
ADMIN_PASSWORD="change-me"
